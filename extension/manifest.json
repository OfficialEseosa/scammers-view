{
  "manifest_version": 3,
  "name": "Scammer's View: Is this a scam?",
  "short_name": "Scammer's View",
  "version": "0.1.0",
  "description": "Right-click any text or link to check it for scam warning signs. Optional warning banner in Gmail.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Scammer's View", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "permissions": ["contextMenus", "sidePanel", "storage", "scripting"],
  "host_permissions": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
  "optional_host_permissions": ["https://*/*", "https://mail.google.com/*"]
}
