{
  "manifest_version": 3,
  "name": "Scammer's View: Is this a scam?",
  "short_name": "Scammer's View",
  "version": "0.2.6",
  "description": "Check any text or link for scam warning signs, and let the cleanup agent remove your listings and lock down your accounts while you watch.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Scammer's View", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "permissions": ["contextMenus", "sidePanel", "storage", "scripting", "alarms", "notifications"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*.spokeo.com/*",
    "https://*.whitepages.com/*",
    "https://*.beenverified.com/*",
    "https://*.radaris.com/*",
    "https://*.truepeoplesearch.com/*",
    "https://*.fastpeoplesearch.com/*",
    "https://*.instagram.com/*",
    "https://*.linkedin.com/*",
    "https://x.com/*",
    "https://*.twitter.com/*",
    "https://*.tiktok.com/*",
    "https://github.com/*",
    "https://*.wayup.com/*",
    "https://wayup.com/*",
    "https://*.devpost.com/*",
    "https://devpost.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "https://mail.google.com/*"],
  "content_scripts": [
    { "matches": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"], "js": ["bridge.js"], "run_at": "document_start" }
  ],
  "web_accessible_resources": []
}
