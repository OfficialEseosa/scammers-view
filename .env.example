ELEVENLABS_API_KEY=
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
AWS_REGION=
APIFY_TOKEN=
GEMINI_MODEL_REASONING=
GEMINI_MODEL_FAST=
GEMINI_MODEL_LITE=

# Optional: Gemini model for the practice-call scammer and grader (defaults to GEMINI_MODEL_FAST)
GEMINI_MODEL_CALL=

# Optional: Typesense for "Is this a scam?" (falls back to built-in search when unset).
# Load the collections with `npm run index:typesense`.
TYPESENSE_HOST=
TYPESENSE_API_KEY=

# Optional: "has this been reported?" lookups for links in checked messages (Google Safe Browsing).
# Free key from the same Google Cloud project; only the links are sent, never the message.
SAFE_BROWSING_API_KEY=
# Phone numbers are matched against the FTC's public daily complaint files (no key needed;
# the numbers never leave the server). Set to "off" to skip downloading them.
FTC_LOOKUPS=

# "Check my Gmail" reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (see README for the Google
# Cloud setup). Set this when the app runs behind a public URL so the redirect address matches.
AUTH_URL=

# Optional: live practice calls (LiveKit + agent/ worker). All four must be set, or the tab
# offers the turn-by-turn browser call only. Phones need the app over HTTPS for the microphone.
# LiveKit (Cloud or self-hosted)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Shared secret between the app and the agent/ worker; any long random string
CALL_AGENT_SECRET=
# Live calls allowed at once (each one uses speech-to-text and voice minutes)
MAX_LIVE_CALLS=3

# agent/ worker only (it also reads LIVEKIT_*, CALL_AGENT_SECRET and ELEVENLABS_API_KEY)
APP_URL=http://localhost:3000
DEEPGRAM_API_KEY=
ADMIN_EMAIL=
